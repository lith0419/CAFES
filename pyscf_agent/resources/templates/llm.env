#!/usr/bin/env bash

# Local, optional LLM configuration for the PySCF Agent interfaces.
#
# Create the private file once:
#   pyscf-agent-configure init-llm
#
# Load it in the shell that starts the Web UI or CLI:
#   source ./llm.env
#
# Keep empty values when no LLM should be used. The numerical execution paths
# remain available without this configuration.

export PYSCF_AGENT_LLM_BASE_URL=""
export PYSCF_AGENT_LLM_MODEL=""
export PYSCF_AGENT_LLM_API_KEY=""
export PYSCF_AGENT_LLM_TIMEOUT="30"
