{
  "schema": "pyscf-agent.hamiltonian-dataset-spec.v1",
  "dataset_id": "qm9-500-b3lyp-def2svp-aimd-qh9-v1",
  "name": "QM9 500: B3LYP/def2-SVP AIMD with QH9 SCF accuracy",
  "target_molecule_count": 500,
  "geometries_per_molecule": 100,
  "compatibility_profile": "qh9",
  "electronic_structure": {
    "method": "dft",
    "xc": "b3lyp",
    "basis": "def2-svp",
    "restricted": true,
    "scf_options": {
      "conv_tol": 1e-13,
      "conv_tol_grad": 3.16e-5,
      "grid_level": 3,
      "diis_space": 8,
      "max_cycle": 50
    }
  },
  "molecular_dynamics": {
    "ensemble": "nve",
    "temperature_kelvin": 300.0,
    "time_step_au": 50.0,
    "steps": 100,
    "sample_stride": 1,
    "sample_offset": 0,
    "base_velocity_seed": 0
  },
  "ao_convention": "qh9",
  "coordinate_unit": "Angstrom",
  "split_protocol": "molecule_random",
  "split_fractions": {"train": 0.8, "validation": 0.1, "test": 0.1},
  "split_seed": 20260921,
  "require_converged": true
}
